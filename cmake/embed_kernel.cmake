# Worldseed Engine — embed an OpenCL C kernel as a C string literal.
#
# OpenCL is loaded from the system at runtime and the kernel source must travel
# inside the executable (the product ships no OpenCL runtime, ADR-001). This
# script reads a .cl file and writes a generated .c that defines
#   const char ws_kernel_<name>[] = "...";
# with quotes, backslashes and newlines escaped.
#
# Invoked as: cmake -DKERNEL_IN=... -DKERNEL_OUT=... -DKERNEL_NAME=... -P embed_kernel.cmake

if(NOT KERNEL_IN OR NOT KERNEL_OUT OR NOT KERNEL_NAME)
  message(FATAL_ERROR "embed_kernel.cmake: KERNEL_IN, KERNEL_OUT and KERNEL_NAME are required")
endif()

file(READ "${KERNEL_IN}" kernel_text)

string(REPLACE "\\" "\\\\" kernel_text "${kernel_text}")
string(REPLACE "\"" "\\\"" kernel_text "${kernel_text}")
string(REPLACE "\r\n" "\n" kernel_text "${kernel_text}")
string(REPLACE "\r" "\n" kernel_text "${kernel_text}")
# One C string literal per source line keeps every literal short: the C99
# standard only guarantees translation of string literals up to 4095 characters,
# and -Woverlength-strings (a warning-as-error in this project) rejects longer
# ones. The host concatenates the parts via clCreateProgramWithSource.
string(REPLACE "\n" "\\n\",\n\"" kernel_text "${kernel_text}")

file(WRITE "${KERNEL_OUT}"
"/* Generated by embed_kernel.cmake from ${KERNEL_NAME}.cl. Do not edit. */\n"
"#include <stddef.h>\n"
"const char *const ws_kernel_${KERNEL_NAME}_parts[] = {\n"
"\"${kernel_text}\",\n"
"NULL\n"
"};\n"
"const unsigned int ws_kernel_${KERNEL_NAME}_part_count =\n"
"    (unsigned int)(sizeof(ws_kernel_${KERNEL_NAME}_parts) / sizeof(ws_kernel_${KERNEL_NAME}_parts[0]) - 1u);\n")
